{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "//dev:api": "The worker half, holding the D1 bindings. Vite proxies /api here. Add --remote to read and write the real iris-d1 and helios-d1 instead of empty local copies.",
    "dev:api": "wrangler dev --port 8788",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "cf-typegen": "wrangler types",
    "test": "vitest run"
  },
  "dependencies": {
    "@aureline/shared-types": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.5.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
